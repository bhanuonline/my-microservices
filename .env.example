# ---------------------------------------------------------------------------
# .env.example — copy to .env and fill in before running `docker compose up`.
#
#   cp .env.example .env
#   docker compose up -d
#
# .env is gitignored. Never commit real values here.
#
# Spring Boot services started outside Docker (mvn spring-boot:run) do NOT
# auto-read .env. Source it first, or export the vars manually:
#   set -a; source .env; set +a
#   mvn -pl user-service spring-boot:run
# ---------------------------------------------------------------------------

# MySQL root password shared by the three dev DBs (userdb, productdb, authdb)
MYSQL_ROOT_PASSWORD=changeme

# DB credentials used by Spring services. Keep username=root for dev.
DB_USERNAME=root
DB_PASSWORD=changeme

# Vault dev-mode root token. Fine as a well-known value for study only.
# Also used by auth-server (jdbc profile) as its Vault transit token.
VAULT_DEV_ROOT_TOKEN=root

# auth-server UI basic-auth user (Spring Security form login). Dev only.
AUTH_UI_USERNAME=admin
AUTH_UI_PASSWORD=password

# Grafana admin login. Required by Compose — unset = startup fails fast.
# Change on first login; the dashboard also reads this.
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=changeme

# From-address Grafana puts on alert emails sent to mailhog.
# No real mailbox needs to exist — mailhog accepts everything.
GF_SMTP_FROM=grafana@localhost

# ---------------------------------------------------------------------------
# Payment gateway — Stripe (Phase 2 of the payment-gateway work)
# ---------------------------------------------------------------------------
# Flip to true to activate StripePaymentProvider. Default false so services
# with no Stripe keys configured still boot cleanly.
PAYMENT_STRIPE_ENABLED=false
# Stripe test-mode secret key (sk_test_...). Get it from
# https://dashboard.stripe.com/test/apikeys. Never commit a live key.
STRIPE_SECRET_KEY=
# Printed by `stripe listen --forward-to localhost:8091/webhooks/stripe`
# when you start the Stripe CLI. Changes every run of the CLI.
STRIPE_WEBHOOK_SECRET=
# Where Stripe redirects the user after they pay or cancel. The literal
# {CHECKOUT_SESSION_ID} placeholder is substituted by Stripe at redirect.
STRIPE_SUCCESS_URL=http://localhost:3001/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3001/checkout/cancel

# ---------------------------------------------------------------------------
# Payment gateway — Razorpay (Phase 3)
# ---------------------------------------------------------------------------
# Flip to true to activate RazorpayPaymentProvider. Default false.
PAYMENT_RAZORPAY_ENABLED=false
# Razorpay test-mode credentials. Get from
# https://dashboard.razorpay.com/app/keys (switch to "Test mode" first).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret — chosen by you when you create a webhook under
# https://dashboard.razorpay.com/app/webhooks. Paste the same string here.
RAZORPAY_WEBHOOK_SECRET=
# URL of the Checkout.js hosted page (served by order-service via gateway).
RAZORPAY_CHECKOUT_URL=http://localhost:8080/razorpay/checkout

# ---------------------------------------------------------------------------
# Payment gateway — PayPal (Phase 4)
# ---------------------------------------------------------------------------
# Flip to true to activate PayPalPaymentProvider. Default false.
PAYMENT_PAYPAL_ENABLED=false
# Sandbox credentials from https://developer.paypal.com/dashboard/applications/sandbox
# → create REST app → copy Client ID + Secret.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id — assigned by PayPal when you create the webhook subscription at
# https://developer.paypal.com/dashboard/webhooks. Required for signature
# verification. Point the webhook URL at your public tunnel → /webhooks/paypal.
PAYPAL_WEBHOOK_ID=
# sandbox (default) or production
PAYPAL_ENV=sandbox
PAYPAL_RETURN_URL=http://localhost:3001/checkout/success?provider=paypal
PAYPAL_CANCEL_URL=http://localhost:3001/checkout/cancel?provider=paypal

# ---------------------------------------------------------------------------
# Payment gateway — Checkout.com (Phase 5, split-capture)
# ---------------------------------------------------------------------------
# Flip to true to activate CheckoutDotComPaymentProvider. This provider is the
# first split-capture one — a POST /api/v1/checkout with provider=checkoutcom
# triggers Authorize only; capture or void is operator-driven (Commit 3).
PAYMENT_CHECKOUTCOM_ENABLED=false
# Sandbox URL by default; swap for https://api.checkout.com for production.
CHECKOUTCOM_BASE_URL=https://api.sandbox.checkout.com
# Secret key from https://dashboard.sandbox.checkout.com → Developers → Keys.
CHECKOUTCOM_SECRET_KEY=
# Webhook signing secret, set when you create the webhook in the dashboard.
CHECKOUTCOM_WEBHOOK_SECRET=
# Checkout.com-provided test token that always authorizes.
# Alternatives: tok_card_decline (always declines), tok_card_3ds (3DS challenge).
CHECKOUTCOM_TEST_TOKEN=tok_card_visa_1
