  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Total lag per consumer group across all partitions. Anything > 0 that doesn't drain is where to look first.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 100}, {"color": "red", "value": 1000}]}, "unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"displayMode": "gradient", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showUnfilled": true, "valueMode": "color"},
      "targets": [
        {
          "expr": "sum by (consumergroup) (kafka_consumergroup_lag{consumergroup=~\"$group\"})",
          "legendFormat": "{{consumergroup}}",
          "refId": "A"
        }
      ],
      "title": "Total lag by consumer group",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Lag broken down by topic for the selected consumer group. Use the dropdown to switch groups.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"stacking": {"mode": "normal"}}, "unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "sum by (topic) (kafka_consumergroup_lag{consumergroup=~\"$group\"})",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ],
      "title": "Lag by topic (group: $group)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Lag over time per consumer group. A healthy consumer flatlines near 0. A climbing line = consumer slower than producer.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "sum by (consumergroup) (kafka_consumergroup_lag)",
          "legendFormat": "{{consumergroup}}",
          "refId": "A"
        }
      ],
      "title": "Lag over time — all consumer groups",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Rate of messages the consumer is draining per second. Compare against producer rate on microservices-red to spot a slow consumer.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "mps"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "sum by (consumergroup, topic) (rate(kafka_consumergroup_current_offset{consumergroup=~\"$group\"}[1m]))",
          "legendFormat": "{{consumergroup}} / {{topic}}",
          "refId": "A"
        }
      ],
      "title": "Consume rate (group: $group)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Partitions tracked by kafka-exporter. Spike or drop = topic was added, deleted, or partition count changed.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "short"}},
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 16},
      "id": 5,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"},
      "targets": [
        {
          "expr": "count(kafka_topic_partitions)",
          "legendFormat": "topics",
          "refId": "A"
        },
        {
          "expr": "sum(kafka_topic_partitions)",
          "legendFormat": "partitions",
          "refId": "B"
        }
      ],
      "title": "Topics / partitions tracked",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Dead-letter topic depth. Any growth means messages are poisoned and the retry logic has given up. Investigate the matching DLT via kafka-ui or kafka-console-consumer.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "short"}},
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 16},
      "id": 6,
      "options": {"colorMode": "background", "graphMode": "area", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"},
      "targets": [
        {
          "expr": "sum by (topic) (kafka_topic_partition_current_offset{topic=~\".*\\\\.DLT$|error\\\\..*\"})",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ],
      "title": "DLT depth (poisoned messages)",
      "type": "stat"
    }
  ],
