{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "New sagas kicked off per minute. Sudden drop = order-service degraded; sudden spike = usually load test.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "sagas/min"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single"}},
      "targets": [
        {
          "expr": "sum(rate(orders_saga_started_total[1m])) * 60",
          "legendFormat": "started",
          "refId": "A"
        }
      ],
      "title": "Sagas started / min",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Terminal outcomes stacked. Watch for compensated/failed growing relative to completed — the system is still 'up' but silently losing orders.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"stacking": {"mode": "normal"}}, "unit": "sagas/min"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "sum by (outcome) (rate(orders_saga_terminal_total[1m])) * 60",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Terminal outcomes (completed / failed / compensated)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "End-to-end saga duration (STARTED → terminal) per outcome. Measured from OrderSaga.createdAt — survives order-service restarts.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "s"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (outcome, le) (rate(orders_saga_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{outcome}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (outcome, le) (rate(orders_saga_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{outcome}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (outcome, le) (rate(orders_saga_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{outcome}}",
          "refId": "C"
        }
      ],
      "title": "Saga duration — p50 / p95 / p99 by outcome",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Top failure/compensation reasons over the dashboard range. Click a traceId from Loki to open the trace in Zipkin.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"align": "auto", "cellOptions": {"type": "auto"}}, "unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "options": {"cellHeight": "sm", "footer": {"countRows": false, "fields": "", "reducer": ["sum"], "show": false}, "showHeader": true, "sortBy": [{"desc": true, "displayName": "Value"}]},
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "topk(10, sum by (outcome, reason) (increase(orders_saga_terminal_total{outcome!=\"completed\"}[$__range])))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{outcome}} / {{reason}}",
          "refId": "A"
        }
      ],
      "title": "Top failure reasons (dashboard range)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "__name__": true, "application": true, "instance": true, "job": true, "stack": true},
            "indexByName": {},
            "renameByName": {"outcome": "Outcome", "reason": "Reason", "Value": "Count"}
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "In-flight sagas = started - all terminals. If this grows unbounded, something between start() and the reply handlers is dropping messages.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 50}, {"color": "red", "value": 200}]}, "unit": "short"}},
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 16},
      "id": 5,
      "options": {"colorMode": "background", "graphMode": "area", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"},
      "targets": [
        {
          "expr": "sum(orders_saga_started_total) - sum(orders_saga_terminal_total)",
          "legendFormat": "in-flight sagas",
          "refId": "A"
        }
      ],
      "title": "In-flight sagas (started minus terminal)",
      "type": "stat"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["microservices", "saga", "orders"],
  "templating": {"list": []},
  "time": {"from": "now-30m", "to": "now"},
  "timepicker": {},
  "timezone": "",
  "title": "Order Saga — business metrics",
  "uid": "order-saga",
  "version": 1,
  "weekStart": ""
