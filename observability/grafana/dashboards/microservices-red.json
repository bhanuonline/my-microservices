    {
      "type": "stat",
      "title": "DLT depth (poisoned msgs)",
      "description": "Total messages sitting across all *.DLT and error.* topics. 0 = green, any poisoned message = red.",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "id": 9,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "sum(kafka_topic_partition_current_offset{topic=~\".*\\\\.DLT$|error\\\\..*\"})",
          "legendFormat": "DLT total",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "In-flight sagas",
      "description": "started - terminal. Healthy range is near zero. Climbing = reply handler stuck or payment/notify service down.",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "id": 10,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 50},
              {"color": "red", "value": 200}
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "sum(orders_saga_started_total) - sum(orders_saga_terminal_total)",
          "legendFormat": "in-flight",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "reqps"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "id": 1,
      "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "sum by (application) (rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "title": "Rate — HTTP req/s per service",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "percentunit"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "id": 2,
      "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{status=~\"5..\"}[1m])) / sum by (application) (rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "title": "Errors — 5xx rate per service",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "s"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "id": 3,
      "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (application, le) (rate(http_server_requests_seconds_bucket[1m])))",
          "legendFormat": "p95 {{application}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (application, le) (rate(http_server_requests_seconds_bucket[1m])))",
          "legendFormat": "p99 {{application}}",
          "refId": "B"
        }
      ],
      "title": "Duration — p95/p99 latency per service",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "bytes"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "id": 4,
      "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "title": "JVM heap used per service",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [
        {"options": {"0": {"color": "green", "text": "CLOSED"}}, "type": "value"},
        {"options": {"1": {"color": "yellow", "text": "DISABLED"}}, "type": "value"},
        {"options": {"2": {"color": "orange", "text": "HALF_OPEN"}}, "type": "value"},
        {"options": {"3": {"color": "red", "text": "OPEN"}}, "type": "value"},
        {"options": {"4": {"color": "red", "text": "FORCED_OPEN"}}, "type": "value"}
      ]}},
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 20},
      "id": 5,
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value_and_name"},
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_state",
          "legendFormat": "{{application}} / {{name}}",
          "refId": "A"
        }
      ],
      "title": "Resilience4j circuit breaker state (CLOSED=green, OPEN=red)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "short"}},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 26},
      "id": 6,
      "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "sum by (name, kind) (rate(resilience4j_circuitbreaker_calls_total[1m]))",
          "legendFormat": "{{name}} / {{kind}}",
          "refId": "A"
        }
      ],
      "title": "Circuit breaker call outcomes (successful / failed / not_permitted)",
      "type": "timeseries"
