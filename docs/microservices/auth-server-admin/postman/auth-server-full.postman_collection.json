    {
      "name": "5. Account lockout — unlock via REST",
      "item": [
        {
          "name": "POST /api/v1/admin/users/{id}/unlock",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/users/1/unlock",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "users", "1", "unlock"]
            },
            "description": "Feature 5 — clears failed_attempts + locked_until. Requires scope=admin.unlock. Replace '1' with the user id you want to unlock.\n\nTo TRIGGER a lockout, use the browser: 5 failed logins as any user via /login → account locked for 15 min → this endpoint unlocks."
          }
        }
      ]
    },
    {
      "name": "6. Rate limiting probe",
      "item": [
        {
          "name": "Blast /oauth2/token (200 sequential — bucket refills)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "console.log('Sequential requests refill the bucket. To see 429, use the shell:');",
                  "console.log('  seq 1 200 | xargs -n1 -P50 -I{} curl -s -o /dev/null -w \"%{http_code}\\\\n\" \\\\');",
                  "console.log('    -u m2m-client:BAD -d \"grant_type=client_credentials\" \\\\');",
                  "console.log('    http://localhost:8095/oauth2/token | sort | uniq -c');",
                  "console.log('Expect ~120 x 401, ~80 x 429.');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{m2m_client_id}}", "type": "string" },
                { "key": "password", "value": "BAD", "type": "string" }
              ]
            },
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "client_credentials", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/oauth2/token",
              "host": ["{{base_url}}"],
              "path": ["oauth2", "token"]
            },
            "description": "Feature 6 — Postman is sequential + slow enough that the token bucket refills between requests, so you won't see 429 from here alone. Test script prints a shell one-liner that DOES trigger the limit (parallel via xargs -P50)."
          }
        }
      ]
    },
    {
      "name": "10. Prometheus metrics",
      "item": [
        {
          "name": "GET /actuator/prometheus (custom auth_* counters)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const text = pm.response.text();",
                  "const lines = text.split('\\n').filter(l => l.startsWith('auth_'));",
                  "console.log('Custom auth_ counters:');",
                  "lines.forEach(l => console.log('  ' + l));",
                  "pm.test('at least one auth_ metric', () => pm.expect(lines.length).to.be.greaterThan(0));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/actuator/prometheus",
              "host": ["{{base_url}}"],
              "path": ["actuator", "prometheus"]
            },
            "description": "Feature 10 — Prometheus text format. Test script filters to our custom counters:\n  auth_tokens_issued_total{grant, client_id}\n  auth_login_attempts_total{result}\n  auth_lockouts_total\n  auth_rate_limit_denials_total{endpoint}\n  auth_key_rotations_total"
          }
        }
      ]
    },
    {
      "name": "9. Zipkin tracing (external UI)",
      "item": [
        {
          "name": "GET /api/v2/traces (Zipkin API — recent traces)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const traces = pm.response.json();",
                  "console.log('trace count:', traces.length);",
                  "if (traces.length > 0) {",
                  "  console.log('spans in most recent trace:');",
                  "  traces[0].forEach(s => {",
                  "    const ms = (s.duration || 0) / 1000;",
                  "    console.log('  ' + s.name.padEnd(40) + ms.toFixed(1) + 'ms');",
                  "  });",
                  "}",
                  "pm.test('at least one trace', () => pm.expect(traces.length).to.be.greaterThan(0));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{zipkin_url}}/api/v2/traces?serviceName=authservice&limit=5",
              "host": ["{{zipkin_url}}"],
              "path": ["api", "v2", "traces"],
              "query": [
                { "key": "serviceName", "value": "authservice" },
                { "key": "limit", "value": "5" }
              ]
            },
            "description": "Feature 9 — query Zipkin directly. Also open http://localhost:9411 for the UI waterfall view. Look for the custom 'vault.sign' span (Feature 11)."
          }
        }
      ]
    },
    {
      "name": "11. KMS-backed keys (Vault verification)",
      "item": [
        {
          "name": "GET /oauth2/jwks — confirm Vault kid prefix",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "const kid = b.keys[0].kid;",
                  "console.log('primary kid:', kid);",
                  "if (kid.startsWith('vault:')) {",
                  "  pm.test('Feature 11: Vault backend active (kid starts with vault:)', () => pm.expect(kid).to.match(/^vault:/));",
                  "} else {",
                  "  console.log('JPA backend active — set features.kms-keys.backend=vault to switch');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/oauth2/jwks",
              "host": ["{{base_url}}"],
              "path": ["oauth2", "jwks"]
            },
            "description": "Feature 11 signature check: on Vault backend the kid is 'vault:auth-server:v1', on JPA it's a UUID."
          }
        },
        {
          "name": "GET Vault status (health)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{vault_url}}/v1/sys/health",
              "host": ["{{vault_url}}"],
              "path": ["v1", "sys", "health"]
            }
          }
        },
        {
          "name": "GET Vault transit key metadata",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Vault-Token", "value": "root" }
            ],
            "url": {
              "raw": "{{vault_url}}/v1/transit/keys/auth-server",
              "host": ["{{vault_url}}"],
              "path": ["v1", "transit", "keys", "auth-server"]
            },
            "description": "Shows every version of the RSA key (public parts only — private never leaves Vault). Feature 3 rotation via /api/v1/admin/keys/rotate does NOT reach Vault yet (documented follow-up)."
          }
        }
      ]
    },
    {
      "name": "BROWSER-ONLY flows (open in a real browser)",
