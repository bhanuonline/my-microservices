      "item": [
        {
          "name": "GET /api/v1/admin/keys",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/keys",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "keys"]
