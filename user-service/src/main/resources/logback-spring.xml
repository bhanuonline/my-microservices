<?xml version="1.0" encoding="UTF-8"?>
<!--
  Delegates to logback-observability.xml (from common-lib) for:
    - JSON output (default) with MDC keys: traceId, spanId, correlationId
    - Text output when -Dspring.profiles.active=local
    - Framework noise tuning (Netty, R2DBC, etc.)
-->
<configuration>
    <include resource="logback-observability.xml"/>

    <!-- user-service-specific overrides go here.
         Example: uncomment to trace SQL statements during local dev.
    <springProfile name="local">
        <logger name="org.hibernate.SQL" level="DEBUG"/>
        <logger name="org.hibernate.orm.jdbc.bind" level="TRACE"/>
    </springProfile>
    -->
</configuration>
