<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>my-microservices</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <!-- Core microservices system -->
        <module>common-lib</module>
        <module>eureka-server</module>
        <module>config-server</module>
        <module>api-gateway</module>
        <module>auth-server</module>
        <module>resource-server</module>
        <module>user-service</module>
        <module>product-service</module>
        <module>order-service</module>
        <module>paymentservice</module>
        <module>notification</module>
        <module>order-query</module>
        <module>product-query</module>
        <module>graphql-bff</module>
        <module>shop-ui</module>
        <module>backoffice-ui</module>

        <!-- Trading / study project (angle-app) builds only with -Pwith-angle. -->

        <!-- Study / practice projects live under study-projects/ and are
             NOT built by default. Uncomment individually to include. -->
        <!--
        <module>study-projects/interview</module>
        <module>study-projects/admin</module>
        <module>study-projects/process</module>
        <module>study-projects/service</module>
        <module>study-projects/prepration</module>
        <module>study-projects/food-delivery</module>
        <module>study-projects/client-app</module>
        <module>study-projects/spring-security-apps</module>
        <module>study-projects/jwtAuthApp</module>
        <module>study-projects/fast-api</module>
        <module>study-projects/kite</module>
        <module>study-projects/algolia</module>
        -->
    </modules>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/> <!-- always fetch from repo  3.2.5 3.0.6 2.7.11 3.3.1-->
    </parent>

    <properties>
        <java.version>17</java.version>
        <spring-cloud.version>2023.0.3</spring-cloud.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Plugin versions centrally managed. Bumping here bumps every service. -->
        <git-commit-id-plugin.version>7.0.0</git-commit-id-plugin.version>
        <!-- Avro + Confluent Schema Registry (Tier 2). Pin once here. -->
        <avro.version>1.11.3</avro.version>
        <confluent.version>7.6.1</confluent.version>
        <!-- gRPC (Tier 4). Match protoc-gen-grpc-java to grpc.version. -->
        <grpc.version>1.63.0</grpc.version>
        <protobuf.version>3.25.1</protobuf.version>
        <os-maven-plugin.version>1.7.1</os-maven-plugin.version>
        <protobuf-maven-plugin.version>0.6.1</protobuf-maven-plugin.version>
        <!-- springdoc-openapi — one version pinned here, services opt in with a bare dep.
             2.5.0 is the last line compatible with Spring Boot 3.2.x. -->
        <springdoc.version>2.5.0</springdoc.version>
    </properties>

    <!-- Confluent artefacts (kafka-avro-serializer, etc.) aren't on Maven Central. -->
    <repositories>
        <repository>
            <id>confluent</id>
            <url>https://packages.confluent.io/maven/</url>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>confluent</id>
            <url>https://packages.confluent.io/maven/</url>
        </pluginRepository>
    </pluginRepositories>

    <dependencyManagement>
        <dependencies>
            <!-- BOM: Spring Cloud versions -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Menu items: children opt in with a bare <dependency> tag -->
            <dependency>
                <groupId>jakarta.servlet</groupId>
                <artifactId>jakarta.servlet-api</artifactId>
                <version>6.0.0</version>
                <scope>provided</scope>
            </dependency>

            <!-- springdoc-openapi (OpenAPI 3 + Swagger UI). Two flavors:
                 - webmvc-ui  → servlet services (user/product/order/auth/…)
                 - webflux-ui → reactive services (gateway) -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Universal: every service uses these -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
    </dependencies>

    <!--
        pluginManagement — configure plugins CENTRALLY. Children opt-in with just:

            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>io.github.git-commit-id</groupId>
                        <artifactId>git-commit-id-maven-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>

        Version, executions, and configuration are inherited from here. To
        override for a specific service, redeclare + override the field.

        Why pluginManagement (not <build><plugins>) — plugins here are NOT active
        by default. Each child chooses which to enable. Modules like `angle-app`
        (frontend, no build-info) skip both; every Spring Boot service opts in.
    -->
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <executions>
                        <!-- Generates META-INF/build-info.properties → /actuator/info.build.*
                             Runs during the `generate-resources` phase (before `compile`). -->
                        <execution>
                            <id>build-info</id>
                            <goals>
                                <goal>build-info</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>io.github.git-commit-id</groupId>
                    <artifactId>git-commit-id-maven-plugin</artifactId>
                    <version>${git-commit-id-plugin.version}</version>
                    <executions>
                        <!-- Generates META-INF/git.properties → /actuator/info.git.* -->
                        <execution>
                            <id>get-the-git-infos</id>
                            <phase>initialize</phase>
                            <goals>
                                <goal>revision</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <!-- Building from a tarball (no .git)? Skip gracefully instead of failing. -->
                        <failOnNoGitDirectory>false</failOnNoGitDirectory>
                        <generateGitPropertiesFile>true</generateGitPropertiesFile>
                        <!-- Only expose useful fields. Full property set would leak commit messages
                             + user names into /actuator/info which is safe but noisy. -->
                        <includeOnlyProperties>
                            <includeOnlyProperty>^git.branch$</includeOnlyProperty>
                            <includeOnlyProperty>^git.commit.id$</includeOnlyProperty>
                            <includeOnlyProperty>^git.commit.id.abbrev$</includeOnlyProperty>
                            <includeOnlyProperty>^git.commit.time$</includeOnlyProperty>
                            <includeOnlyProperty>^git.commit.message.short$</includeOnlyProperty>
                            <includeOnlyProperty>^git.dirty$</includeOnlyProperty>
                        </includeOnlyProperties>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Opt-in build of the trading / study project.
             Default reactor is the 16 core microservices;
             use `mvn -Pwith-angle ...` to also build angle-app. -->
        <profile>
            <id>with-angle</id>
            <modules>
                <module>angle-app</module>
            </modules>
        </profile>
    </profiles>
</project>