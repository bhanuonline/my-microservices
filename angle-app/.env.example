# ================================================================
# angle-app local secrets — TEMPLATE (safe to commit)
# ================================================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#   # then edit .env
#
# .env is gitignored and auto-loaded on startup by spring-dotenv.
# ================================================================

# --- MySQL (local dev DB) ---
DB_USER=root
DB_PASSWORD=CHANGE_ME

# --- Angel One SmartAPI (broker login) ---
# From https://smartapi.angelbroking.com/
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# --- Anthropic Claude (AI signals, briefing, news tagging) ---
# From https://console.anthropic.com/settings/keys
# Leave blank to disable AI features.
ANTHROPIC_API_KEY=

# --- Alpha Vantage (Global Markets dashboard) ---
# Free key from https://www.alphavantage.co/support/#api-key
# Free tier = 500 calls/day, 5/min.
ALPHA_VANTAGE_KEY=

# --- Alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_PHONE=
WHATSAPP_API_KEY=

# --- Other brokers (future — not wired yet) ---
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=
KITE_API_KEY=
KITE_API_SECRET=

# --- UI version switch ---
UI_VERSION=v1

# --- Session cookie ---
# false for local dev (http). Set to true in prod (https).
SESSION_COOKIE_SECURE=false

# --- Remember-me signing key ---
# Generate:  openssl rand -base64 48
REMEMBER_ME_KEY=
