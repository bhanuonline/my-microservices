          }
        },
        {
          "name": "Backtest — OB retest (SMC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/analysis/backtest?strategy=ob-retest",
              "host": ["{{baseUrl}}"],
              "path": ["api", "analysis", "backtest"],
