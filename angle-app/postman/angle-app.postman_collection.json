        {
          "name": "Option chain — NIFTY",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/instruments/option-chain?underlying={{underlying}}&expiry={{optionExpiry}}",
