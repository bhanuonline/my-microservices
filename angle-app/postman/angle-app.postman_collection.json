        {
          "name": "Futures — CRUDEOIL (MCX) — find token here",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/instruments/futures?underlying={{underlyingMcx}}",
