{
  "info": {
    "_postman_id": "a1c2d3e4-f5b6-7890-abcd-ef1234567890",
    "name": "AngleApp",
    "description": "Full API surface for angle-app. Import the AngleApp Local environment before running any request.\n\nSecurity notes:\n- `/api/**` uses HTTP Basic (user: alex / demo123). Toggle collection auth or per-folder auth if security is on.\n- Web routes (dashboard, admin, auth) use session cookies. Log in via `/auth/login` first — Postman keeps the JSESSIONID cookie automatically.\n- Run with `spring.profiles.active=nosec` locally to skip auth entirely.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Analysis",
      "description": "Backtesting and candle-fetch endpoints.",
      "item": [
        {
          "name": "Run backtest on Nifty CSV",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/analysis/backtest",
              "host": ["{{baseUrl}}"],
              "path": ["api", "analysis", "backtest"]
            },
            "description": "Runs the default strategy (moving-average-crossover) on the local Nifty CSV file and returns a BacktestResult."
          }
        },
        {
          "name": "Get candles — Nifty 50 (index)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/analysis/candles?broker={{broker}}&exchange={{exchange}}&symbolToken={{nifty50Token}}&interval={{interval}}&from={{fromDate}}&to={{toDate}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "analysis", "candles"],
              "query": [
                { "key": "broker", "value": "{{broker}}" },
                { "key": "exchange", "value": "{{exchange}}" },
                { "key": "symbolToken", "value": "{{nifty50Token}}" },
                { "key": "interval", "value": "{{interval}}" },
                { "key": "from", "value": "{{fromDate}}" },
                { "key": "to", "value": "{{toDate}}" }
              ]
            },
            "description": "Daily candles for the Nifty 50 index. Volume will always be 0 for indices."
          }
        },
        {
          "name": "Get candles — Reliance (equity)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/analysis/candles?broker={{broker}}&exchange={{exchange}}&symbolToken={{relianceToken}}&interval={{interval}}&from={{fromDate}}&to={{toDate}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "analysis", "candles"],
              "query": [
                { "key": "broker", "value": "{{broker}}" },
                { "key": "exchange", "value": "{{exchange}}" },
                { "key": "symbolToken", "value": "{{relianceToken}}" },
                { "key": "interval", "value": "{{interval}}" },
                { "key": "from", "value": "{{fromDate}}" },
                { "key": "to", "value": "{{toDate}}" }
              ]
            },
            "description": "Daily candles for Reliance Industries (NSE)."
          }
        },
        {
          "name": "Get candles — Nifty option (NFO)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/analysis/candles?broker={{broker}}&exchange={{exchangeFo}}&symbolToken={{sampleOptionToken}}&interval={{interval}}&from={{fromDate}}&to={{toDate}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "analysis", "candles"],
              "query": [
                { "key": "broker", "value": "{{broker}}" },
                { "key": "exchange", "value": "{{exchangeFo}}" },
                { "key": "symbolToken", "value": "{{sampleOptionToken}}" },
                { "key": "interval", "value": "{{interval}}" },
                { "key": "from", "value": "{{fromDate}}" },
                { "key": "to", "value": "{{toDate}}" }
              ]
            },
            "description": "Daily candles for a Nifty option contract (option premium series). Uses NFO exchange segment."
          }
        }
      ]
    },
    {
      "name": "Instruments",
      "description": "Scrip master lookups. First run should hit /refresh or wait for the initial async load to complete.",
      "item": [
        {
          "name": "Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/instruments/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "instruments", "status"]
            },
            "description": "Returns { count } — number of instruments currently loaded. Non-zero means scrip master is ready."
          }
        },
        {
          "name": "Refresh (force download)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/instruments/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "instruments", "refresh"]
            },
            "description": "Force-downloads the latest scrip master from Angel and rebuilds the in-memory index. Ignores the local disk cache."
          }
        },
        {
          "name": "Lookup by symbol",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/instruments/lookup?symbol=NIFTY15SEP2626000PE",
              "host": ["{{baseUrl}}"],
              "path": ["api", "instruments", "lookup"],
              "query": [
                { "key": "symbol", "value": "NIFTY15SEP2626000PE" }
              ]
            },
            "description": "Look up a single instrument by its full symbol name."
          }
        },
        {
          "name": "Lookup by token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/instruments/lookup-by-token?token={{sampleOptionToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "instruments", "lookup-by-token"],
              "query": [
                { "key": "token", "value": "{{sampleOptionToken}}" }
              ]
            },
            "description": "Look up an instrument by its Angel numeric token."
          }
        },
        {
          "name": "Find option",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/instruments/option?underlying={{underlying}}&expiry={{optionExpiry}}&strike={{optionStrike}}&type={{optionType}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "instruments", "option"],
              "query": [
                { "key": "underlying", "value": "{{underlying}}" },
                { "key": "expiry", "value": "{{optionExpiry}}" },
                { "key": "strike", "value": "{{optionStrike}}" },
                { "key": "type", "value": "{{optionType}}" }
              ]
            },
            "description": "Human-readable option lookup. Returns the Instrument (with token) matching underlying × expiry × strike × CE/PE."
          }
        },
        {
          "name": "Available expiries",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/instruments/expiries?underlying={{underlying}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "instruments", "expiries"],
              "query": [
                { "key": "underlying", "value": "{{underlying}}" }
              ]
            },
            "description": "All available option expiries for an underlying (e.g. NIFTY, BANKNIFTY)."
          }
        },
        {
          "name": "Option chain",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/instruments/option-chain?underlying={{underlying}}&expiry={{optionExpiry}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "instruments", "option-chain"],
              "query": [
                { "key": "underlying", "value": "{{underlying}}" },
                { "key": "expiry", "value": "{{optionExpiry}}" }
              ]
            },
            "description": "All CE + PE contracts for a specific underlying + expiry, sorted by strike then CE-before-PE."
          }
        },
        {
          "name": "Futures",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/instruments/futures?underlying={{underlying}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "instruments", "futures"],
              "query": [
                { "key": "underlying", "value": "{{underlying}}" }
              ]
            },
            "description": "All active future contracts for an underlying, sorted by expiry."
          }
        }
      ]
    },
