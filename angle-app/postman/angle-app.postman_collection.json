    {
      "name": "Paper Trading — Live NSE",
      "description": "Live paper trading on NSE equity / indices. Session polls Angel every N seconds during market hours (9:15–15:30 IST).",
      "item": [
        {
          "name": "Start live — Nifty 50 (Ensemble, 1-min)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"strategyName\": \"ensemble\",\n  \"sourceType\": \"angel-live\",\n  \"symbolToken\": \"{{nifty50Token}}\",\n  \"exchange\": \"{{exchange}}\",\n  \"interval\": \"{{intervalMinute}}\",\n  \"warmupCandles\": 100,\n  \"pollIntervalSeconds\": 30\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/paper/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "paper", "sessions"]
