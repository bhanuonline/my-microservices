    {
      "name": "Analysis — Analyst (buy/sell decision)",
      "description": "One-shot analyst report combining every strategy's view + SMC context into a single recommendation.",
      "item": [
        {
          "name": "Analyst (CSV — no broker needed)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/analysis/analyst",
              "host": ["{{baseUrl}}"],
              "path": ["api", "analysis", "analyst"]
            }
          }
        },
        {
          "name": "Analyst — Live Nifty (NSE)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/analysis/analyst?broker={{broker}}&exchange={{exchange}}&symbolToken={{nifty50Token}}&interval={{interval}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "analysis", "analyst"],
              "query": [
                { "key": "broker",      "value": "{{broker}}" },
                { "key": "exchange",    "value": "{{exchange}}" },
                { "key": "symbolToken", "value": "{{nifty50Token}}" },
                { "key": "interval",    "value": "{{interval}}" }
              ]
            }
          }
        },
        {
          "name": "Analyst — Live Reliance (NSE equity)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/analysis/analyst?broker={{broker}}&exchange={{exchange}}&symbolToken={{relianceToken}}&interval={{interval}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "analysis", "analyst"],
              "query": [
                { "key": "broker",      "value": "{{broker}}" },
                { "key": "exchange",    "value": "{{exchange}}" },
                { "key": "symbolToken", "value": "{{relianceToken}}" },
                { "key": "interval",    "value": "{{interval}}" }
              ]
            }
          }
        },
        {
          "name": "Analyst — Live Crude Oil (MCX)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/analysis/analyst?broker={{broker}}&exchange={{exchangeMcx}}&symbolToken={{crudeToken}}&interval={{intervalFive}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "analysis", "analyst"],
              "query": [
                { "key": "broker",      "value": "{{broker}}" },
                { "key": "exchange",    "value": "{{exchangeMcx}}" },
                { "key": "symbolToken", "value": "{{crudeToken}}" },
                { "key": "interval",    "value": "{{intervalFive}}", "description": "Crude works best on 5-min or higher" }
              ]
            },
            "description": "Requires {{crudeToken}} to be populated first (Instruments → Futures — CRUDEOIL)."
          }
        }
      ]
    },
