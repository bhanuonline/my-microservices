{
  "info": {
    "_postman_id": "a1c2d3e4-f5b6-7890-abcd-ef1234567890",
    "name": "AngleApp",
    "description": "Full API surface for angle-app — analysis, instruments, paper trading (replay + live NSE + live MCX), and auth.\n\nUsage: import both this collection AND the AngleApp Local environment; then top-right dropdown → select the environment.\n\nAuth: collection root uses HTTP Basic (alex/demo123). Auth/Home/Dashboard folders override to no-auth. Admin folder uses admin credentials. If you run with spring.profiles.active=nosec, set collection Auth to No Auth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{username}}", "type": "string" },
      { "key": "password", "value": "{{password}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Analysis — Backtest & Strategies",
      "description": "Backtest strategies against the bundled Nifty CSV.",
      "item": [
        {
          "name": "List available strategies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/analysis/strategies",
              "host": ["{{baseUrl}}"],
              "path": ["api", "analysis", "strategies"]
            },
            "description": "Returns every registered strategy name — use one of these as ?strategy=..."
          }
        },
        {
          "name": "Backtest (default strategy)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/analysis/backtest",
              "host": ["{{baseUrl}}"],
              "path": ["api", "analysis", "backtest"]
            },
            "description": "Runs the strategy configured as analysis.strategy.default-strategy."
          }
        },
        {
          "name": "Backtest — SMA crossover",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/analysis/backtest?strategy=moving-average-crossover",
              "host": ["{{baseUrl}}"],
              "path": ["api", "analysis", "backtest"],
              "query": [{ "key": "strategy", "value": "moving-average-crossover" }]
