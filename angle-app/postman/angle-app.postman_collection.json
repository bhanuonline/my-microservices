        },
        {
          "name": "Backtest — Sweep + FVG (SMC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/analysis/backtest?strategy=sweep-fvg",
              "host": ["{{baseUrl}}"],
